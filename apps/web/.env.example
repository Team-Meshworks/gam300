# Optional Vite hot reload with the API. Copy to .env.local in apps/web.
# Leave these commented to run the frontend without an API.
# The packaged Compose gateway already serves the frontend and API together;
# it does not use these Vite settings. See docs/deployment.md for stack setup.
# Never prefix server/private settings with VITE_ or put database credentials here.

# SPATIA_API_ORIGIN=https://localhost:8444
# SPATIA_DEV_TLS_CERT=C:/private/spatia/localhost-cert.pem
# SPATIA_DEV_TLS_KEY=C:/private/spatia/localhost-key.pem
# SPATIA_API_CA=C:/private/spatia/gateway-root.crt

# Use a localhost certificate trusted by your browser. SPATIA_API_CA is only
# needed when the API certificate is signed by a private/local CA.
# Certificate verification remains enabled. Then run:
# npm run dev -- --host localhost --port 5181 --strictPort
# Open https://localhost:5181/landing (not http).
