{
  "name": "spatia-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.19.0",
    "npm": "^11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:editor",
    "build:editor": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:architecture": "node architecture.mjs",
    "graph:architecture": "node architecture.mjs --write",
    "test:architecture": "node architecture.check.mjs",
    "test:unit": "vitest run",
    "test:browser": "node tests/editor-shell.check.mjs",
    "test:integration": "node tests/editor-integration.check.mjs",
    "test:caching": "node tests/caching.check.mjs",
    "measure:caching": "node tests/caching.measure.mjs",
    "test:server-autosave": "node tests/server-autosave.check.mjs",
    "test:recovery": "node tests/local-drafts.check.mjs",
    "test:history": "node tests/history-recovery.check.mjs",
    "test:deployment": "node tests/deployment.check.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node tests/ui-foundation.check.mjs",
    "test:entry": "node tests/entry.check.mjs",
    "test:entry-config": "node tests/account-dev-server.check.mjs",
    "test:workspace": "node tests/workspace-routes.check.mjs",
    "test:new-project": "node tests/new-project.check.mjs",
    "test:classes": "node tests/class-assignment.check.mjs",
    "test:review-directory": "node tests/review-directory.check.mjs",
    "test:sounds": "node tests/ui-sounds.check.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "punycode": "2.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/punycode": "2.1.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
