{
	admin off
	auto_https disable_redirects
	default_sni {$SITE_IP}
}

(site) {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	import application {args[0]}
}

(domain-site) {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	import application {args[0]}
}

(application) {
	@status path /healthz /version.txt
	handle @status {
		reverse_proxy {args[0]}
	}
	handle {
		# Spatia's /login and authenticated API own account access.
		# An extra HTTP Basic challenge would show the browser's password popup.
		# server.Caddyfile also authorizes restricted catalogue bytes before serving them.
		reverse_proxy {args[0]}
	}
}

http://{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}

https://{$SITE_HOST}:443 {
	import domain-site 127.0.0.1:8081
}

https://{$SITE_HOST}:8443 {
	import domain-site 127.0.0.1:8082
}

http://{$SITE_IP} {
	redir https://{$SITE_IP}{uri} permanent
}

https://{$SITE_IP}:443 {
	import site 127.0.0.1:8081
}

https://{$SITE_IP}:8443 {
	import site 127.0.0.1:8082
}

http://{$SITE_IP}:8080 {
	redir https://{$SITE_IP}:9443{uri} permanent
}

https://{$SITE_IP}:9443 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	reverse_proxy 127.0.0.1:8083
}
